{
  "name": "lonca",
  "version": "0.1.0",
  "private": true,
  "description": "Lonca - an AI-assisted module platform for foundation heritage sites (KOK&KOD Hackathon, Team Kozmos)",
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node test/e2e/uctan-uca.mjs",
    "test:erisim": "node test/e2e/erisilebilirlik.mjs",
    "vendor": "esbuild araclar/vendor/uc-karolar.js --bundle --format=esm --minify --external:three --external:'three/*' --legal-comments=eof --outfile=public/vendor-yerel/uc-karolar.js",
    "konum": "node araclar/konum-bul.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "denetle": "node araclar/ci-denetim.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.0.0",
    "maplibre-gl": "^6.17.0",
    "nodemailer": "^10.3.1",
    "three": "^0.170.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^9.39.5",
    "3d-tiles-renderer": "^0.5.3",
    "axe-core": "^4.14.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10"
  }
}
