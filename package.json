{
  "name": "lonca",
  "version": "0.1.0",
  "private": true,
  "description": "Lonca - an AI-assisted module platform for foundation heritage sites (KOK&KOD Hackathon, Team Kozmos)",
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "test": "node --test \"test/*.test.mjs\"",
    "test:e2e": "node test/e2e/uctan-uca.mjs",
    "vendor": "esbuild araclar/vendor/uc-karolar.js --bundle --format=esm --minify --external:three --external:'three/*' --legal-comments=eof --outfile=public/vendor-yerel/uc-karolar.js",
    "konum": "node araclar/konum-bul.mjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0",
    "leaflet": "^1.9.4",
    "three": "^0.170.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "3d-tiles-renderer": "^0.5.3",
    "playwright": "^1.56.0"
  }
}
