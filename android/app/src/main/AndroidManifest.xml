<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Modül paylaşım bağlantısı: https://kozmos.itaskira.com/m/<anahtar> uygulamayı açar (App Links).
                 Doğrulama için sunucu /.well-known/assetlinks.json'u ANDROID_IMZA_SHA256 ile yayımlar; doğrulanmazsa
                 Android bağlantıyı tarayıcıda açar ve web sayfası "Uygulamada aç" (lonca://) şeridini gösterir. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="kozmos.itaskira.com" android:pathPrefix="/m/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lonca" android:host="m" />
            </intent-filter>
            <!-- Google ile giriş: Custom Tab'daki akış bitince sunucu com.kozmos.lonca://google?kod=… adresine döner. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.kozmos.lonca" android:host="google" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <!-- Sunucuyla (kozmos.itaskira.com) konuşmak için; kullanıcıya sorulmaz. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Çevrimdışı ↔ çevrimiçi geçişini fark etmek için (@capacitor/network); kullanıcıya sorulmaz. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Yakınımdaki eserler" için. Uygulama açılışında değil, yalnızca bu özellik kullanıldığı an sorulur.
         Android 12+ kullanıcıya "yaklaşık konum" seçeneğini de sunar; o da yeterlidir. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Dalışta durak değişince hafif titreşim (@capacitor/haptics); kullanıcıya sorulmaz. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Android 11+: metin okuma (TTS) motorunu bulabilmek için -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
