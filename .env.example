# Copy: cp .env.example .env  — .env never goes into the repository
PORT=3000

# ---------- AI journeyman (kalfa) ----------
# If nothing is filled in, the journeyman answers from a built-in template ("fake mode").
# If KALFA_* is empty but USTAGPT_BASE_URL + USTAGPT_API_KEY are set (see the bottom), the journeyman uses
# that endpoint with KALFA_MODEL (default gemini-3.8-flash).

# A) FREE: Google Gemini (no card required). Key: https://aistudio.google.com/apikey
KALFA_SAGLAYICI=openai-uyumlu
KALFA_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
KALFA_API_ANAHTARI=
KALFA_MODEL=gemini-3.8-flash
# If the daily quota runs out, try the higher-quota Flash-Lite model (take the name from the AI Studio list).

# A2) OpenCode Go (paid subscription, OpenAI-compatible). The server sends the
# required x-opencode-session header automatically.
# KALFA_SAGLAYICI=openai-uyumlu
# KALFA_API_URL=https://opencode.ai/inference/go/openai/v1
# KALFA_API_ANAHTARI=oc_sk_...
# KALFA_MODEL=deepseek-v4.1-flash

# B) Claude (paid, needs credit in the Console) — comment out A to use this:
# KALFA_SAGLAYICI=anthropic
# ANTHROPIC_API_KEY=
# KALFA_MODEL=claude-sonnet-5-5

# C) On your own machine, offline (Ollama):
# KALFA_SAGLAYICI=openai-uyumlu
# KALFA_API_URL=http://localhost:11434/v1
# KALFA_MODEL=qwen2.5-coder:7b

# Set to 1 to always use the fake journeyman (offline fallback)
KALFA_SAHTE=

# ---------- Administration ----------
# Password for publishing, removing, deleting and editing content in Studio.
# Left empty means "development mode": those actions are open without a password
# (the server warns about this at startup).
YONETICI_SIFRE=
# Maximum number of journeyman requests one IP may send in ten minutes
KALFA_SINIR=30

# ---------- Maps and real 3D (Google) ----------
# When empty, the map uses OpenStreetMap and 3D uses a parametric model.
# Google Cloud Console -> APIs: "Map Tiles API" (2D map + Photorealistic 3D Tiles) and,
# optionally, "Places API (New)" (for `npm run konum` to find work coordinates).
# The key is shipped to the browser: add an "HTTP referrers" restriction in the Cloud
# Console (for example localhost:3000/*, your-domain/*).
GOOGLE_HARITA_ANAHTARI=

# ---------- Dalış kalfası (Studio → Atölye → "Dalış") ----------
# Ustanın isteğini uydudan eserin içine inen kaydırmalı geziye çevirir. OpenAI uyumlu, görsel üretebilen
# bir uç nokta gerekir (sohbet + görsel düzenleme). Uydu görüntüsü Esri World Imagery'den anahtarsız alınır.
# Gerekenler: ffmpeg ve ffprobe (PATH'te; macOS: brew install ffmpeg, Ubuntu: sudo apt install ffmpeg,
# Windows: winget install Gyan.FFmpeg), python3 + Pillow (pip3 install Pillow). Eksikse kalfa başlamadan söyler.
# Not: KALFA_* yalnızca modül kalfası içindir; dalış kalfası DALIS_* (yoksa USTAGPT_*) okur. Bir dalış ~12-15 görsel üretir ve birkaç dakika sürer.
# DALIS_API_URL=https://.../v1
# DALIS_API_ANAHTARI=
# Görsel modeller (sırayla denenir; "sohbet:" önekliler /chat/completions ile çağrılır)
# DALIS_MODELLER=sohbet:gemini-3.1-flash-image,nano-banana-2
# Plan ve görsel anlama (fotoğraf tanıma, ayrıntıların yerini bulma) için metin modelleri
# DALIS_METIN_MODELLERI=gemini-3.5-flash,gpt-6.1-sol

# ---------- Ağ erişimi (Docker / aynı Wi-Fi'deki telefon) ----------
# Doluysa bütün /api uçları "x-lonca-anahtar" başlığında bu anahtarı ya da eşleştirmeyle verilen bir
# cihaz anahtarını ister. Boşsa /api ağdaki herkese açıktır. Üret: openssl rand -hex 24
# Telefon eşleştirme: docker compose exec lonca node araclar/eslestir.mjs
LONCA_API_ANAHTARI=

# ---------- İnternette yayın (docker-compose.sunucu.yml: Nginx + Let's Encrypt) ----------
# Alan adının DNS A kaydı sunucunun genel IP'sini göstermeli. İlk sertifika: ./docker/sertifika-al.sh
LONCA_ALAN_ADI=
# Let's Encrypt'in süre bildirimleri için e-posta
LONCA_EPOSTA=
# Boşsa alan adının kökünde yayınlanır; "/lonca" verilirse https://alan/lonca/ altında
LONCA_YOL_ONEKI=

# ---------- Android uygulaması ----------
# İnternetteki sunucunun adresi (Nginx arkası alan adı). ./apk.sh bunu APK'ya gömer; uygulama önce bunu dener,
# ulaşamazsa aynı Wi-Fi'de sunucu arar, o da yoksa paketteki veriyle çalışır. Örnek: https://lonca.example.com
LONCA_SUNUCU_URL=
