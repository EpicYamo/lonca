# Copy: cp .env.example .env  — .env never goes into the repository
PORT=3000

# ---------- Yapay zekâ sağlayıcısı: UstaGPT (birincil) ----------
# OpenAI uyumlu; tek anahtarla birçok modele erişim verir (gpt-*, gemini-*, claude-*…). Modül kalfası ve dalış
# kalfası, KALFA_API_URL / DALIS_API_URL boşsa bunu kullanır. Modeller Studio'da seçilir (Atölye → üstteki model
# rozeti ya da kalfa panelindeki ayar düğmesi); seçim data/kalfa-ayarlari.json'a yazılır ve aşağıdaki
# KALFA_MODEL / DALIS_* model değerlerini geçersiz kılar. Hiçbir şey doldurulmazsa kalfa hazır şablonla
# ("sahte mod") çalışır.
USTAGPT_BASE_URL=https://api.ustagpt.com.tr/v1
USTAGPT_API_KEY=

# ---------- AI journeyman (kalfa) ----------
# Optional: Studio selection > KALFA_MODEL > default (deepseek-v4-flash on UstaGPT).
# Hangi modellerin gerçekten modül üretebildiğini görmek için: node araclar/kalfa-model-tara.mjs
# (ya da Studio → Kalfa modelleri → "Modelleri test et").
KALFA_MODEL=
# Sağlayıcıya giden tek bir kalfa isteğinin en uzun süresi, saniye (boşsa 150). Takılan model Studio'yu bekletmesin.
KALFA_ZAMAN_ASIMI_SN=

# Other endpoints instead of UstaGPT (optional):
# A) OpenCode Go (paid subscription, OpenAI-compatible). The server sends the
# required x-opencode-session header automatically.
# KALFA_SAGLAYICI=openai-uyumlu
# KALFA_API_URL=https://opencode.ai/inference/go/openai/v1
# KALFA_API_ANAHTARI=oc_sk_...
# KALFA_MODEL=deepseek-v4.1-flash

# B) Claude (paid, needs credit in the Console):
# KALFA_SAGLAYICI=anthropic
# ANTHROPIC_API_KEY=
# KALFA_MODEL=claude-sonnet-5-5

# C) On your own machine, offline (Ollama):
# KALFA_SAGLAYICI=openai-uyumlu
# KALFA_API_URL=http://localhost:11434/v1
# KALFA_MODEL=qwen2.5-coder:7b

# Set to 1 to always use the fake journeyman (offline fallback)
KALFA_SAHTE=

# ---------- Administration ----------
# Password for publishing, removing, deleting and editing content in Studio.
# Left empty means "development mode": those actions are open without a password
# (the server warns about this at startup).
YONETICI_SIFRE=
# Maximum number of journeyman requests one IP may send in ten minutes
KALFA_SINIR=30

# ---------- Accounts (usta / admin) ----------
# When YONETICI_SIFRE is set, the whole Studio sits behind a login screen. Anyone who signs up
# becomes an usta (builds modules with the journeyman, submits them, sees Studio data read-only).
# Admins (role "editor") approve, publish and edit everything; they come from ILK_KULLANICILAR.
# Secret that signs login tokens. Leave empty to have one generated into data/.oturum-anahtari
# (gitignored). Changing it signs everyone out. Generate: openssl rand -hex 32
OTURUM_ANAHTARI=
# Sign-up / login attempts allowed per IP in ten minutes
HESAP_SINIR=20
# Ready-made team accounts: when ILK_SIFRE is set, the users in ILK_KULLANICILAR that do not
# exist yet are created as admin (editor) with this initial password. On first login each one must set
# a new password before anything else works. Existing accounts are never touched.
ILK_SIFRE=
# Comma-separated usernames (default: arda,ibrahim,sevilay)
ILK_KULLANICILAR=

# ---------- Maps and real 3D (Google) ----------
# When empty, the map uses OpenStreetMap and 3D uses a parametric model.
# Google Cloud Console -> APIs: "Map Tiles API" (2D map + Photorealistic 3D Tiles) and,
# optionally, "Places API (New)" (for `npm run konum` to find work coordinates).
# The key is shipped to the browser: add an "HTTP referrers" restriction in the Cloud
# Console (for example localhost:3000/*, your-domain/*).
GOOGLE_HARITA_ANAHTARI=

# ---------- Dalış kalfası (Studio → Atölye → "Dalış") ----------
# Ustanın isteğini uydudan eserin içine inen kaydırmalı geziye çevirir. OpenAI uyumlu, görsel üretebilen
# bir uç nokta gerekir (sohbet + görsel düzenleme). Uydu görüntüsü Esri World Imagery'den anahtarsız alınır.
# Gerekenler: ffmpeg ve ffprobe (PATH'te; macOS: brew install ffmpeg, Ubuntu: sudo apt install ffmpeg,
# Windows: winget install Gyan.FFmpeg), python3 + Pillow (pip3 install Pillow). Eksikse kalfa başlamadan söyler.
# Not: KALFA_* yalnızca modül kalfası içindir; dalış kalfası DALIS_* (yoksa USTAGPT_*) okur. Bir dalış ~12-15 görsel üretir ve birkaç dakika sürer.
# UstaGPT dışında bir uç nokta için (isteğe bağlı):
# DALIS_API_URL=https://.../v1
# DALIS_API_ANAHTARI=
# Görsel modeller (Studio seçimi yoksa; sırayla denenir; "sohbet:" önekliler /chat/completions ile çağrılır)
# DALIS_MODELLER=sohbet:gemini-3.1-flash-image,nano-banana-2
# Plan ve görsel anlama (fotoğraf tanıma, ayrıntıların yerini bulma) için metin modelleri (Studio seçimi yoksa)
# DALIS_METIN_MODELLERI=gemini-3.5-flash,gpt-6.1-sol

# ---------- Ağ erişimi (Docker / aynı Wi-Fi'deki telefon) ----------
# Doluysa bütün /api uçları "x-lonca-anahtar" başlığında bu anahtarı ya da eşleştirmeyle verilen bir
# cihaz anahtarını ister. Boşsa /api ağdaki herkese açıktır. Üret: openssl rand -hex 24
# Telefon eşleştirme: docker compose exec lonca node araclar/eslestir.mjs
LONCA_API_ANAHTARI=

# ---------- İnternette yayın (docker-compose.sunucu.yml: Nginx + Let's Encrypt) ----------
# Alan adının DNS A kaydı sunucunun genel IP'sini göstermeli. İlk sertifika: ./docker/sertifika-al.sh
# Boşsa projenin alan adı kozmos.itaskira.com kullanılır
LONCA_ALAN_ADI=kozmos.itaskira.com
# Let's Encrypt'in süre bildirimleri için e-posta
LONCA_EPOSTA=
# Boşsa alan adının kökünde yayınlanır; "/lonca" verilirse https://alan/lonca/ altında
LONCA_YOL_ONEKI=

# ---------- İnternette yayın, Cloudflare Tunnel ile (docker-compose.cloudflare.yml; önerilen) ----------
# Port açmadan ve sertifika almadan yayın. Zero Trust → Networks → Tunnels'ta oluşturulan tünelin token'ı.
# Public hostname: alan adı → HTTP lonca:3000
CLOUDFLARE_TUNNEL_TOKEN=
# Vekil arkasında hız sınırının okuyacağı gerçek istemci IP başlığı. cloudflare overlay'i cf-connecting-ip yapar;
# yalnızca Lonca'nın portu dışarı kapalıyken doldur (yoksa başlık sahtelenebilir). Boşsa bağlantının IP'si kullanılır.
LONCA_IP_BASLIGI=

# ---------- Android uygulaması ----------
# Uygulamanın bağlanacağı tek sunucu (internetteki alan adı). ./apk.sh bunu APK'ya gömer; uygulama ağ taraması
# yapmaz, yalnızca bu adrese bağlanır, ulaşamazsa paketteki veriyle çalışır. Boşsa https://kozmos.itaskira.com;
# yerel deneme için tam adres verilebilir (http://192.168.1.20:3000), sunucusuz paket için "yok" yaz.
LONCA_SUNUCU_URL=https://kozmos.itaskira.com
